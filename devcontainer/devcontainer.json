{
  "name": "Ubuntu 26.04 Cloud PC",
  // استخدام صورة أوبونتو 26.04 الرسمية المخصصة لبيئات التطوير
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",

  // تخصيص بيئة VS Code والإضافات المفيدة
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  // أوامر يتم تنفيذها تلقائياً فور إنشائها وتجهيزها
  "postCreateCommand": "sudo apt-get update && sudo apt-get upgrade -y",

  // فتح المنافذ (Ports) تلقائياً إذا كنت تختبر تطبيقات الويب (مثال: المنفذ 3000 و 8080)
  // "forwardPorts": [3000, 8080],

  // تثبيت ميزات إضافية سريعة (اختياري: مثل Node.js أو Python أو Docker)
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    }
  },

  // المستخدم الافتراضي للبيئة (يمتلك صلاحيات sudo بأمان)
  "remoteUser": "vscode"
}
