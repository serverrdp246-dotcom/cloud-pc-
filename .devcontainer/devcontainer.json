{
  "name": "Ubuntu 24.04 Cloud PC with noVNC",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": "latest",
    "ghcr.io/devcontainers/features/github-cli:1": "latest",
    // إضافة ميزة سطح المكتب و noVNC رسمياً
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest"
    }
  },

  // توجيه منفذ noVNC (6080) وإظهار رابط الوصول للويب
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop GUI",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "echo 'Cloud PC is ready with noVNC GUI!'",
  "remoteUser": "vscode"
}
